{
  "name": "cortico-world-opencode-quota",
  "version": "0.3.0",
  "type": "module",
  "description": "OpenCode Go 订阅额度监控：按独立 API Key 去重合并、支持已用/剩余双模式一键切换、内置月度本地记录趋势与虚线预测图、默认 piggyback 低打扰事件投递。",
  "license": "MIT",
  "author": "云纪",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unnori/cortico-world-opencode-quota.git"
  },
  "homepage": "https://github.com/Unnori/cortico-world-opencode-quota#readme",
  "bugs": {
    "url": "https://github.com/Unnori/cortico-world-opencode-quota/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "opencode",
    "quota",
    "usage"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "OpenCode 额度",
    "icon": "icon.png",
    "tags": [
      "diagnostics"
    ],
    "locales": {
      "zh": {
        "displayName": "OpenCode 额度",
        "description": "OpenCode Go 订阅额度监控面板与查询工具：实时展示每 5 小时 / 每周 / 每月额度与重置倒计时，支持「剩余额度 / 已用额度」一键切换、按独立 API Key 自动去重合并、基于本地记录的月度趋势与虚线预测图，以及默认 piggyback 低打扰（五模式可配）事件投递。"
      },
      "en": {
        "displayName": "OpenCode Quota",
        "description": "OpenCode Go subscription allowance monitor: live 5-hour, weekly, and monthly quota cards with one-click Remaining/Used display toggle, automatic deduplication per unique API key, local monthly usage/remaining trend & dashed forecast charts, and quiet piggyback event delivery (all 5 Cortico trigger modes configurable)."
      }
    },
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": [
    "src",
    "dist",
    "icon.png",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:webui": "esbuild src/webui/client.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/webui.js && esbuild src/webui/style.css --bundle --outfile=dist/webui.css",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.8",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
